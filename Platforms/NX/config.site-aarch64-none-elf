# config.site override for cross compiling CPython to Nintendo Switch homebrew.
#
# Usage:
#   CONFIG_SITE=../Platforms/NX/config.site-aarch64-none-elf \
#     ../configure --host=aarch64-none-elf --build=$(../config.guess) ...

