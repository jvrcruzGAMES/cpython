# libnx/devkitA64 static homebrew does not support dlopen-style extension
# modules. Build stdlib extension modules into the interpreter instead.
ac_cv_func_dlopen=no
ac_cv_header_dlfcn_h=no
ac_cv_header_sys_resource_h=no
ac_cv_lib_dl_dlopen=no
MODULE_BUILDTYPE=static

# Avoid probing optional desktop libraries unless the caller explicitly
# overrides these variables for installed Switch portlibs. Compression
# libraries are enabled through pkg-config by Platforms/NX/build-portlibs.sh.
with_ensurepip=no
with_readline=no
with_dbmliborder=

# CPython's _ssl and _hashlib sources are OpenSSL API consumers. The Switch
# port uses the built-in HACL/hash modules for hashlib algorithms and exposes
# mbedTLS availability through switch_ssl for Switch-specific integrations.
ac_cv_working_openssl_ssl=no
ac_cv_working_openssl_hashlib=no
have_libffi=no
have_sqlite3=no
