ac_cv_file__dev_ptc=no
ac_cv_func_chown=no
ac_cv_func_chroot=no
ac_cv_func_clock_getres=no
ac_cv_func_clock_gettime=no
ac_cv_func_clock_nanosleep=no
ac_cv_func_clock_settime=no
